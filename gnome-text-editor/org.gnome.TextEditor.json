{
    "app-id": "org.gnome.TextEditor",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "gnome-text-editor",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=host",
        "--metadata=X-DConf=at-spi-path="
    ],
    "modules": [
    {
            "name": "editorconfig-core-c",
            "buildsystem": "cmake",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/editorconfig/editorconfig-core-c.git",
                    "tag": "v0.12.9"
                }
            ]
        },
        {
            "name": "gtksourceview",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/gtksourceview.git",
                    "tag": "5.20.0"
                }
            ]
        },
	{
            "name": "libspelling",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/libspelling.git",
                    "tag": "0.4.0"
                }
            ]
        },
        {
            "name": "gnome-text-editor",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/gnome-text-editor.git",
                    "tag": "50.0"
                }
            ]
        }
    ]
}
